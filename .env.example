# Copier ce fichier vers .env et renseigner les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Azure AI Foundry, API v1 compatible OpenAI : noter le suffixe /openai/v1/
AZURE_BASE_URL=https://<ressource>.openai.azure.com/openai/v1/
AZURE_API_KEY=<clé>

# Nom du DÉPLOIEMENT Azure, pas le nom du modèle.
AZURE_DEPLOYMENT=gpt-5.6-luna
